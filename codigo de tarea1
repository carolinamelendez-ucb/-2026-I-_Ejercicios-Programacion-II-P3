class Pelicula {
private:
    // Atributos
    string titulo;
    string genero;
    int duracion; 

public:
    Pelicula(string t, string g, int d) {
        titulo = t;
        genero = g;
        setDuracion(d);
    }

    // --- Métodos Set (Setters) ---
    void setTitulo(string t) {
        titulo = t;
    }
    void setGenero(string g) {
        genero = g;
    }
    void setDuracion(int d) {
        if (d > 0) {
            duracion = d;
        } else {
            cout << "Error: La duracion debe ser mayor a 0 minutos." << endl;
            duracion = 1; 
        }
    }

    // --- Método Mostrar ---
    void mostrar() {
        cout << "el titulo de la pelicula es : " << titulo << endl;
        cout << "el genero de la pelicula es  : " << genero << endl;
        cout << "La duracion de la pelicula es : " << duracion << " min." << endl;
    }
};
