class Pedido {
private:
    // Atributos
    string codigo;
    string producto;
    int cantidad;
    float precioUnitario;

public:
    Pedido(string c, string p, int cant, float precio) {
        codigo = c;
        producto = p;
        setCantidad(cant);      
        setPrecioUnitario(precio); 
    };
    void setCantidad(int cant) {
        if (cant >= 0) {
            cantidad = cant;
        } else {
            cout << "Error: La cantidad no puede ser negativa. Se asignara 0." << endl;
            cantidad = 0;
        }
    };

    void setPrecioUnitario(float precio) {
        if (precio >= 0) {
            precioUnitario = precio;
        } else {
            cout << "Error: El precio no puede ser negativo. Se asignara 0." << endl;
            precioUnitario = 0;
        }
    }
float calcularTotal() {
    return cantidad * precioUnitario;
}
void mostrar() {
    cout << "codigo  : " << codigo << endl;
    cout << "producto : " << producto << endl;
    cout << "cantidad  : " << cantidad << endl;
    cout << "precio unit : $" << precioUnitario << endl;
    cout << "total pagar : $" << calcularTotal() << endl; // Llamada al método
    cout << "========================================" << endl;
}
};
