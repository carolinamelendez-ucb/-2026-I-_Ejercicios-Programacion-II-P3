class Casa {
private:
    string direccion;
    double precio;
    Propietario propietario;

public:
    Casa() {
        direccion = "";
        precio = 0;
    }

    Casa(string d) {
        direccion = d;
        precio = 0;
    }

    Casa(string d, double p, Propietario pr) {
        direccion = d;
        precio = p;
        propietario = pr;
    }

    string getDireccion() { return direccion; }
    double getPrecio() { return precio; }
    Propietario getPropietario() { return propietario; }

    void setDireccion(string d) { direccion = d; }
    void setPrecio(double p) { precio = p; }
    void setPropietario(Propietario pr) { propietario = pr; }

    void mostrar() {
        cout << "\n--- CASA ---" << endl;
        cout << "Direccion: " << direccion << endl;
        cout << "Precio: " << precio << endl;
        propietario.mostrar();
    }
};

